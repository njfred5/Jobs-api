PORT=3000
NODE_ENV=development
DATABASE_URL=./database.sqlite
# Required in production: long random string (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# How long Jobicy responses are cached (minutes)
JOBS_CACHE_MINUTES=15
